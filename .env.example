# Web Analytics (optional in local dev, required in production)
VITE_YM_ID=
VITE_GA_ID=

# Supabase (optional: when empty, interactive masterplan reads src/data/lots.json)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# amoCRM REST API v4 (configure in Netlify Dashboard -> Environment Variables, scope: Functions)
AMOCRM_SUBDOMAIN=
AMOCRM_ACCESS_TOKEN=
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=
# Optional custom field IDs in amoCRM (leave empty to attach metadata as a lead note only)
AMOCRM_CF_UTM_SOURCE=
AMOCRM_CF_UTM_MEDIUM=
AMOCRM_CF_UTM_CAMPAIGN=
AMOCRM_CF_UTM_CONTENT=
AMOCRM_CF_UTM_TERM=
AMOCRM_CF_YM_CLIENT_ID=
AMOCRM_CF_GA_CLIENT_ID=
AMOCRM_CF_LOT_ID=
AMOCRM_CF_BUTTON_CONTEXT=
